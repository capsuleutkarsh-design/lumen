<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+): the gold g of assets/brand/gleo.svg on midnight. The monochrome
     layer (Android 13 themed icons) uses the g's shape only. Made by tool/brand/build_brand.py. -->
